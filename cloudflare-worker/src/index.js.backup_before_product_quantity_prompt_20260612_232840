function i18nBoolean(value, language = "en") {
  const normalized = String(value).toLowerCase();

  const isTrue = (
    normalized === "true"
    || normalized === "1"
    || normalized === "yes"
    || normalized === "on"
  );

  const labels = {
    en: { yes: "Yes", no: "No" },
    de: { yes: "Ja", no: "Nein" },
    tr: { yes: "Evet", no: "Hayır" },
    ar: { yes: "نعم", no: "لا" },
    ru: { yes: "Да", no: "Нет" }
  };

  const selected = labels[language] || labels.en;

  return isTrue ? selected.yes : selected.no;
}


