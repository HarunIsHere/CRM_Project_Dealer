async function handleBasketSelection(env, callbackQuery) {
  const customer = await upsertCustomer(env, callbackQuery.from);
  const language = customer.preferred_language || customer.language || "en";
  const ui = getCartUiText(language);
  const data = callbackQuery.data;

  if (data === "basket_view") {
    await sendBasketView(env, customer, callbackQuery.message.chat.id);
    return;
  }

  if (data === "basket_checkout") {
    await sendTelegramMessage(env, callbackQuery.message.chat.id, ui.checkout_next_stage);
    return;
  }

  const { cart } = await getCartItems(env, customer.id);
  if (!cart) {
    await sendTelegramMessage(env, callbackQuery.message.chat.id, ui.basket_empty);
    return;
  }

  if (data === "basket_clear") {
    await env.DB.prepare("DELETE FROM shopping_cart_items WHERE cart_id = ?").bind(cart.id).run();
    await sendTelegramMessage(env, callbackQuery.message.chat.id, ui.basket_empty);
    return;
  }

  const itemId = Number(
    data
      .replace("basket_remove_", "")
      .replace("basket_increase_", "")
      .replace("basket_decrease_", "")
  );

  const item = await env.DB.prepare(
    "SELECT * FROM shopping_cart_items WHERE id = ? AND cart_id = ?"
  ).bind(itemId, cart.id).first();

  if (!item) {
    await sendBasketView(env, customer, callbackQuery.message.chat.id);
    return;
  }

  if (data.startsWith("basket_remove_")) {
    await env.DB.prepare("DELETE FROM shopping_cart_items WHERE id = ?").bind(itemId).run();
    await sendTelegramMessage(env, callbackQuery.message.chat.id, ui.item_removed);
    await sendBasketView(env, customer, callbackQuery.message.chat.id);
    return;
  }

  if (data.startsWith("basket_increase_")) {
    await env.DB.prepare("UPDATE shopping_cart_items SET quantity = quantity + 1 WHERE id = ?").bind(itemId).run();
    await sendTelegramMessage(env, callbackQuery.message.chat.id, ui.item_updated);
    await sendBasketView(env, customer, callbackQuery.message.chat.id);
    return;
  }

  if (data.startsWith("basket_decrease_")) {
    if (Number(item.quantity) <= 1) {
      await env.DB.prepare("DELETE FROM shopping_cart_items WHERE id = ?").bind(itemId).run();
    } else {
      await env.DB.prepare("UPDATE shopping_cart_items SET quantity = quantity - 1 WHERE id = ?").bind(itemId).run();
    }
    await sendTelegramMessage(env, callbackQuery.message.chat.id, ui.item_updated);
    await sendBasketView(env, customer, callbackQuery.message.chat.id);
  }
}

